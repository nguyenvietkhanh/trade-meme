HOST=127.0.0.1
PORT=3000
# On Railway attach one persistent Volume. RAILWAY_VOLUME_MOUNT_PATH is detected.
# For local use DATA_DIR defaults to .data in this checkout.
# PUBLIC_ORIGIN must exactly match the browser origin (including port locally).
PUBLIC_ORIGIN=http://127.0.0.1:3000
# Helius and Jupiter keys may instead be entered through the authenticated wallet UI.
HELIUS_API_KEY=
JUPITER_API_KEY=
# Optional custom HTTPS mainnet RPC; takes priority over the environment Helius key.
# SOLANA_RPC_URL=https://your-mainnet-rpc.example
# Optional for unattended restart. Leave unset to require manual vault unlock.
# BOT_VAULT_PASSWORD=store-only-in-Railway-Variables
