HOST=127.0.0.1
PORT=3000
# Must exactly match the browser origin. Railway detects RAILWAY_PUBLIC_DOMAIN.
PUBLIC_ORIGIN=http://127.0.0.1:3000
# Optional: enter the real Helius key in Railway Variables, never commit it.
# Blank keeps public RPCs; with a key, Helius mainnet is primary with public fallback.
HELIUS_API_KEY=
# No seed or private key belongs in this file. Jupiter configuration is unchanged.
# LIVE requires persistent storage for pending intents and confirmed receipts.
# Autonomous execution uses the authorized owner signing key on the server.
# Set the actual private key ONLY in Railway secret Variables, never in this file/repository/chat.
# Solana wallet export: Base58, JSON keypair, Base64 or hex, matching the configured owner.
# Public wallet addresses and seed phrases are not signing keys.
# Apply Variables changes and deploy a new Railway container after editing.
LIVE_SIGNER_SECRET_KEY=
# RAILWAY_VOLUME_MOUNT_PATH is supplied by Railway; storage is <mount>/meme-pilot.
# Export the owner ledger before attaching a new volume or redeploying.
# Local DATA_DIR stores owner ledger, encrypted vault, Telegram configuration and scanner metadata.

# TRADING_MODE=live enables autonomous real-wallet mode; authenticate the owner after restart.
# Docker defaults to live; local default is paper.
TRADING_MODE=paper
# Meme spot trading with deterministic Rules V5.0. Docker uses the same product.
# Railway Variables override Docker defaults: set this to solana-spot there too.
TRADING_PRODUCT=solana-spot

# AI inference is disabled by the server. No MODEL_API_KEY is required.
MODEL_TRADING_ENABLED=false
# Optional trusted research-data service; see docs/rules-v5/README.md.
# Keep blank unless an actual provider supplies verified required evidence.
RULES_EVIDENCE_URL=

# Passive live dataset only; does not change decisions, prompt, risk or RPC load.
DATASET_ENABLED=false
DATASET_MAX_MIB=500
DATASET_RETENTION_DAYS=14
DATASET_MIN_FREE_MIB=64
DATASET_BUFFER_MIB=4
DATASET_FLUSH_MS=5000
DATASET_MAX_ACTIVE_LABELS=30000
DATASET_MAX_QUEUED_MESSAGES=16

# LIVE_AI_PROMPT_VERSION is historical and ignored in rules mode.
