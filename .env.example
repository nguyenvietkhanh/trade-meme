HOST=127.0.0.1
PORT=3000
# Must exactly match the browser origin. Railway detects RAILWAY_PUBLIC_DOMAIN.
PUBLIC_ORIGIN=http://127.0.0.1:3000
# Solana public mainnet RPCs are automatic. No Helius/Jupiter key is used.
# No seed, private key or API key belongs in this file.
# DATA_DIR stores scanner metadata; a volume is optional for scanner history.
