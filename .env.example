HOST=127.0.0.1
PORT=3000
# Must exactly match the browser origin. Railway detects RAILWAY_PUBLIC_DOMAIN.
PUBLIC_ORIGIN=http://127.0.0.1:3000
# Optional: keys may instead be entered in the owner-only UI (server memory only).
HELIUS_API_KEY=
# Optional alternative HTTPS mainnet RPC.
# SOLANA_RPC_URL=https://your-mainnet-rpc.example
# DATA_DIR stores scanner metadata only; no wallet key is generated or stored.
# A Railway volume is optional for scanner history and not required to connect/trade.
