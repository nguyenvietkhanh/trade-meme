# Stage 1 reads process environment, does not auto-load .env. See README.
DRY_RUN=true
FORCE_IPV4=true
MIN_LIQUIDITY=10000
MIN_VOLUME=10000
MIN_EDGE_PCT=0.5
SLIPPAGE_BPS=20
MAX_USD_PER_TRADE=25
MAX_OPEN_EXPOSURE=100
DAILY_LOSS_LIMIT=10
INTERVAL=30
MAX_BOOK_AGE=10
MAX_BOOK_SKEW=2
REQUEST_SPACING=0.25
MAX_MARKETS=50
MAX_PAGES=10
RETRIES=3
OUTPUT_DIR=data
STOP_FILE=STOP
# PRIVATE_KEY intentionally absent in stage 1; do not provide one.
