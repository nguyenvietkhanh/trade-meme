# Keep this file local. COPY to .env.ai; never share .env.ai or signer keys.
# Existing Polymarket API wallet from your account. Never use this as a deposit address.
POLYMARKET_WALLET_ADDRESS=
# Owner EVM signer for THIS account, not a seed phrase or your Solana key.
SIGNER_PRIVATE_KEY=
# River key is distinct from all Polymarket credentials.
MODEL_API_KEY=
MODEL_BASE_URL=https://api.river.ai/v1
MODEL_NAME=deepseek-ai/DeepSeek-V4.1-Flash
DRY_RUN=true
# Hard upper bound is 7. Cash is still read from the account dynamically.
MAX_TEST_BUDGET=7
MAX_USD_PER_TRADE=2
MIN_FORECAST_EDGE_PCT=8
MAX_SPREAD_PCT=4
MIN_AI_CONFIDENCE=0.6
AI_INTERVAL_SECONDS=180
MAX_MODEL_CALLS_PER_DAY=24
DAILY_LOSS_LIMIT=1
MAX_OPEN_POSITIONS=3
# Public headline search via news.google.com; no extra API key. Default true.
NEWS_RESEARCH_ENABLED=true
# Hidden Chrome, same installed browser and TLS. False shows diagnostic windows.
BROWSER_HEADLESS=true
