# New strategy: paper-meme-scalp-entry-v1. All strategy thresholds: paper-week/scalp-config.json.
# Optional private JSON overrides (preserved on code update):
# PAPER_SCALP_CONFIG=C:\Users\HLC\scalp-local.json
# Example scalar overrides:
# SCALP_A_SWAP_LIQUIDITY_USD=8000
# SCALP_D_LOSS_MAX=6
# SCALP_D_IMPACT_MAX=2
# REQUIRED to pass B: verified RugCheck/equivalent normalized adapter.
# Missing source = B_UNVERIFIED, retry60s, no automatic BUY.
# PAPER_SCALP_RISK_URL=https://YOUR-VERIFIED-ADAPTER.example/risk
# PAPER_SCALP_RISK_KEY=
# Optional normalized adapter backed by an authorized official GMGN API.
# Without it, GMGN is skipped; profiles/boosts/curve discovery continue.
# PAPER_SCALP_GMGN_URL=https://YOUR-VERIFIED-ADAPTER.example/gmgn
# PAPER_SCALP_GMGN_KEY=
